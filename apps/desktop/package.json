{
  "name": "@wallpaper/desktop",
  "version": "1.2.0",
  "private": true,
  "description": "Wallpaper 退休倒计时大屏（Electron 桌面壳）",
  "author": "Wallpaper",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarveyWebLee/wallpaper.git"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently -n MAIN,WAIT,APP -c blue,yellow,magenta \"pnpm run dev:main\" \"pnpm run wait:web\" \"pnpm run dev:electron\"",
    "dev:main": "tsc -p tsconfig.json --watch",
    "wait:web": "wait-on tcp:127.0.0.1:5173 tcp:127.0.0.1:3000",
    "dev:electron": "cross-env ELECTRON_DISABLE_SECURITY_WARNINGS=true NODE_ENV=development electron .",
    "build": "tsc -p tsconfig.json",
    "package": "electron-builder",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.wallpaper.screensaver",
    "productName": "WallpaperScreensaver",
    "publish": null,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterSign": "build/notarize.cjs",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "wallpaper-screensaver",
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "HarveyWebLee <noreply@users.noreply.github.com>",
      "synopsis": "退休倒计时桌面屏保",
      "description": "展示退休倒计时的桌面屏保，支持自定义出生日期/退休年龄与图片轮播。"
    }
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.3"
  }
}
